*.base

# Claude Code ve geliştirme araçları
.claude/
.claudeignore
graphify-out/
assets/js/graphify-out/
supabase/functions/**/graphify-out/

# IDE
.vscode/

# Sıkıştırılmış arşivler
*.rar
*.zip

# Windows
nul
Thumbs.db
Desktop.ini
