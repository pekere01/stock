# Supabase Edge Function ortam değişkenleri
# Supabase Dashboard → Settings → Edge Functions → Edit secrets bölümüne ekle

# Gmail gönderici hesabı
SMTP_USER=soncagstok@gmail.com

# Google Hesap → Güvenlik → 2FA açık olmalı → Uygulama Şifreleri → "Mail / Windows Bilgisayar" → Oluştur
# Oluşturulan 16 haneli şifreyi boşluksuz buraya yapıştır (örn: abcdwxyzefghijkl)
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
